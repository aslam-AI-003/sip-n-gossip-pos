# Firebase web app config for the NEW "SIP N' GOSSIP CAFE" Firebase project.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These values are public identifiers (not secrets); access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development only: point the app at the Firebase emulators.
# VITE_USE_EMULATOR=true
